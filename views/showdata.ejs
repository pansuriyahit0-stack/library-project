<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/main.css">
    <style>
        .users{
            background-color: rgb(113, 94, 131);
            border-radius: 10px;
            width: 60%;
            margin: auto;
            padding: 10px;
        }
        .one{
            margin-bottom: 10px;
            border-radius: 10px;
            padding: 10px;
            border: solid;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .bname{
            width: 100px;
            /* margin-left: 90px;    */
        }


        .role{
            width: 80px;
            margin-right: 90px;
            /* text-align: center; */
        }
        /* .date{
            width: 80px;
            margin-right: 100px;
            text-align: center; 
        } */

        .date{
            width: 80px;
            margin-right:0;
            
        }
    </style>
</head>
<body>
    <div class="main">
        <div>
            <%- include("nav/navbar") %>
        </div>
        <div class="content">
            <div class="users">
                <div class="one" style="border: none; display: block;">
                    <h3 style="margin-left: auto;"><div class="name">Username:<%=person.name%></div></h3>
                    <h3 style="margin-left: auto;"><div class="role">Role:<%=person.role%></div></h3>
                </div>
                <div class="one" style="border: none;">
                    <div class="bname">Book name</div>
                    <div class="date">Due date</div>
                </div>
                <%for(let i=0;i<person.books.length;i++){%>
                    <div class="one">
                        <div class="bname"><%=person.books[i]%></div>
                        <div class="date"><%=person.dueDates[i]%></div>
                    </div>
                <%}%>
            </div>
        </div>
    </div>
</body>
</html>